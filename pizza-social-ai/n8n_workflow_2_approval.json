{
  "name": "🍕 Pizza Social AI - Approval Handler",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "🔔 Telegram: Button Clicked",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [100, 300],
      "webhookId": "pizza-approval-handler",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-action",
              "name": "action",
              "value": "={{ $json.callback_query.data.split('_')[0] }}",
              "type": "string"
            },
            {
              "id": "set-post-id",
              "name": "post_id",
              "value": "={{ $json.callback_query.data.split('_')[1] }}",
              "type": "string"
            },
            {
              "id": "set-callback-id",
              "name": "callback_query_id",
              "value": "={{ $json.callback_query.id }}",
              "type": "string"
            },
            {
              "id": "set-chat-id",
              "name": "chat_id",
              "value": "={{ $json.callback_query.message.chat.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "📋 Extract Action & Post ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "approve-check",
              "leftValue": "={{ $json.action }}",
              "rightValue": "approve",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "✅ Approved or Rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:8000/pending/{{ $('📋 Extract Action & Post ID').item.json.post_id }}",
        "options": { "response": { "response": { "responseFormat": "json" } } }
      },
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "📦 Get Post Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/post/all",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "caption",            "value": "={{ $json.caption }}" },
            { "name": "hashtags",           "value": "={{ $json.hashtags }}" },
            { "name": "enhanced_image_url", "value": "={{ $json.enhanced_image_url }}" },
            { "name": "video_url",          "value": "={{ $json.video_url }}" }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "🚀 Post to All Platforms",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=http://localhost:8000/pending/{{ $('📋 Extract Action & Post ID').item.json.post_id }}",
        "options": {}
      },
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "🗑️ Delete Pending Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "={{ $('📋 Extract Action & Post ID').item.json.chat_id }}",
        "text": "=🎉 *Posted to all platforms\\!*\n\n{{ $('🚀 Post to All Platforms').item.json.instagram.status === 'success' ? '✅' : '❌' }} Instagram\n{{ $('🚀 Post to All Platforms').item.json.facebook.status === 'success' ? '✅' : '❌' }} Facebook\n{{ $('🚀 Post to All Platforms').item.json.tiktok.status === 'success' ? '✅' : '❌' }} TikTok\n{{ $('🚀 Post to All Platforms').item.json.google_business.status === 'success' ? '✅' : '❌' }} Google Business\n\n_Send another food photo to create more content\\!_",
        "additionalFields": { "parse_mode": "MarkdownV2" }
      },
      "id": "b2c3d4e5-0007-0007-0007-000000000007",
      "name": "🎉 Send Success Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1420, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=http://localhost:8000/pending/{{ $('📋 Extract Action & Post ID').item.json.post_id }}",
        "options": {}
      },
      "id": "b2c3d4e5-0008-0008-0008-000000000008",
      "name": "🗑️ Delete Rejected Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 440]
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "={{ $('📋 Extract Action & Post ID').item.json.chat_id }}",
        "text": "🗑️ Post rejected and discarded\\. Send a new photo when you're ready\\!",
        "additionalFields": { "parse_mode": "MarkdownV2" }
      },
      "id": "b2c3d4e5-0009-0009-0009-000000000009",
      "name": "🗑️ Send Rejection Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 440],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "🔔 Telegram: Button Clicked": {
      "main": [
        [{ "node": "📋 Extract Action & Post ID", "type": "main", "index": 0 }]
      ]
    },
    "📋 Extract Action & Post ID": {
      "main": [
        [{ "node": "✅ Approved or Rejected?", "type": "main", "index": 0 }]
      ]
    },
    "✅ Approved or Rejected?": {
      "main": [
        [{ "node": "📦 Get Post Data", "type": "main", "index": 0 }],
        [{ "node": "🗑️ Delete Rejected Post", "type": "main", "index": 0 }]
      ]
    },
    "📦 Get Post Data": {
      "main": [
        [{ "node": "🚀 Post to All Platforms", "type": "main", "index": 0 }]
      ]
    },
    "🚀 Post to All Platforms": {
      "main": [
        [{ "node": "🗑️ Delete Pending Post", "type": "main", "index": 0 }]
      ]
    },
    "🗑️ Delete Pending Post": {
      "main": [
        [{ "node": "🎉 Send Success Message", "type": "main", "index": 0 }]
      ]
    },
    "🗑️ Delete Rejected Post": {
      "main": [
        [{ "node": "🗑️ Send Rejection Message", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "pizza-social-ai" }]
}
