# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── fal.ai (image enhancement) ─────────────────────────────────────────────────
# Get key at: https://fal.ai/dashboard/keys
FAL_API_KEY=...

# ── Runway (video generation) ──────────────────────────────────────────────────
# Get key at: https://app.runwayml.com/settings
RUNWAY_API_KEY=...

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Create bot via @BotFather and copy the token
TELEGRAM_BOT_TOKEN=...

# ── Publer (social media posting) ──────────────────────────────────────────────
# Get key at: https://publer.io → Settings → API
PUBLER_API_KEY=...
# Profile IDs — run GET /profiles in the app to find these
# (visit http://localhost:8000/profiles after starting the server)
PUBLER_INSTAGRAM_ID=...
PUBLER_FACEBOOK_ID=...
PUBLER_TIKTOK_ID=...
PUBLER_GOOGLE_ID=...

# ── Pizza Shop ─────────────────────────────────────────────────────────────────
PIZZA_SHOP_URL=https://yourpizzashop.com
