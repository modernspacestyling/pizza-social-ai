# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── fal.ai (image enhancement) ─────────────────────────────────────────────────
# Get key at: https://fal.ai/dashboard/keys
FAL_API_KEY=...

# ── Runway (video generation) ──────────────────────────────────────────────────
# Get key at: https://app.runwayml.com/settings
RUNWAY_API_KEY=...

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Create bot via @BotFather and copy the token
TELEGRAM_BOT_TOKEN=...

# ── Meta (Instagram + Facebook) ────────────────────────────────────────────────
# Get from: https://developers.facebook.com → Your App → Access Tokens
META_ACCESS_TOKEN=...
INSTAGRAM_ACCOUNT_ID=...    # Instagram Business Account ID
FACEBOOK_PAGE_ID=...        # Facebook Page ID

# ── TikTok ─────────────────────────────────────────────────────────────────────
# Get from: https://developers.tiktok.com
TIKTOK_ACCESS_TOKEN=...

# ── Google Business Profile ────────────────────────────────────────────────────
# Get via Google OAuth 2.0 with scope: https://www.googleapis.com/auth/business.manage
GOOGLE_ACCESS_TOKEN=...
GOOGLE_LOCATION_ID=accounts/YOUR_ACCOUNT_ID/locations/YOUR_LOCATION_ID

# ── Pizza Shop ─────────────────────────────────────────────────────────────────
PIZZA_SHOP_URL=https://yourpizzashop.com
