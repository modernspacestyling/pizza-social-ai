# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── fal.ai (image enhancement) ─────────────────────────────────────────────────
# Get key at: https://fal.ai/dashboard/keys
FAL_API_KEY=...

# ── Runway (video generation) ──────────────────────────────────────────────────
# Get key at: https://app.runwayml.com/settings
RUNWAY_API_KEY=...

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Create bot via @BotFather and copy the token
TELEGRAM_BOT_TOKEN=...

# ── Blotato (social media posting) ─────────────────────────────────────────────
# Get key at: https://app.blotato.com → Settings → API
BLOTATO_API_KEY=...
# Account IDs — run GET /accounts in the app to find these
# (visit http://localhost:8000/accounts after starting the server)
BLOTATO_INSTAGRAM_ACCOUNT_ID=...
BLOTATO_FACEBOOK_ACCOUNT_ID=...
BLOTATO_FACEBOOK_PAGE_ID=...
BLOTATO_TIKTOK_ACCOUNT_ID=...
BLOTATO_GOOGLE_ACCOUNT_ID=...

# ── Pizza Shop ─────────────────────────────────────────────────────────────────
PIZZA_SHOP_URL=https://yourpizzashop.com
