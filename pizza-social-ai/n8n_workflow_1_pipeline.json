{
  "name": "🍕 Pizza Social AI - Photo Pipeline",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "📱 Telegram: Photo Received",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [100, 300],
      "webhookId": "pizza-photo-pipeline",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "photo-check",
              "leftValue": "={{ $json.message.photo }}",
              "rightValue": "",
              "operator": { "type": "array", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "📸 Has Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.message.photo[$json.message.photo.length - 1].file_id }}"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "📥 Get File Path from Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [540, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-photo-url",
              "name": "photo_url",
              "value": "=https://api.telegram.org/file/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.result.file_path }}",
              "type": "string"
            },
            {
              "id": "set-chat-id",
              "name": "chat_id",
              "value": "={{ $('📱 Telegram: Photo Received').item.json.message.chat.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "🔗 Build Photo URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "={{ $('🔗 Build Photo URL').item.json.chat_id }}",
        "text": "⏳ *Got your photo\\!* Processing now\\.\\.\\.\n\n🔍 Analyzing food\n🎨 Enhancing image with AI\n🎬 Generating video\n\n_This takes about 5\\-8 minutes\\. I'll send it for your approval when ready\\._",
        "additionalFields": {
          "parse_mode": "MarkdownV2"
        }
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "💬 Send Processing Notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/pipeline/full",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "photo_url", "value": "={{ $('🔗 Build Photo URL').item.json.photo_url }}" }
          ]
        },
        "options": {
          "timeout": 600000,
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "🤖 Run Full AI Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/pending/save",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "caption",             "value": "={{ $json.caption }}" },
            { "name": "hashtags",            "value": "={{ $json.hashtags }}" },
            { "name": "enhanced_image_url",  "value": "={{ $json.enhanced_image_url }}" },
            { "name": "video_url",           "value": "={{ $json.video_url }}" },
            { "name": "food_description",    "value": "={{ $json.food_description }}" },
            { "name": "chat_id",             "value": "={{ $('🔗 Build Photo URL').item.json.chat_id }}" }
          ]
        },
        "options": { "response": { "response": { "responseFormat": "json" } } }
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "💾 Save Pending Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "={{ $('🔗 Build Photo URL').item.json.chat_id }}",
        "text": "=✅ *Your post is ready for review\\!*\n\n📝 *Caption:*\n{{ $('🤖 Run Full AI Pipeline').item.json.caption }}\n\n🏷️ *Hashtags:*\n{{ $('🤖 Run Full AI Pipeline').item.json.hashtags }}\n\n🖼️ [View Enhanced Photo]({{ $('🤖 Run Full AI Pipeline').item.json.enhanced_image_url }})\n🎬 [Preview Video]({{ $('🤖 Run Full AI Pipeline').item.json.video_url }})\n\n_Post ID: {{ $json.post_id }}_\n\n👇 *Approve or reject below:*",
        "additionalFields": {
          "parse_mode": "MarkdownV2",
          "reply_markup": {
            "inline_keyboard": [
              [
                {
                  "text": "✅ Approve & Post to All",
                  "callback_data": "=approve_{{ $json.post_id }}"
                },
                {
                  "text": "❌ Reject",
                  "callback_data": "=reject_{{ $json.post_id }}"
                }
              ]
            ]
          }
        }
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "📨 Send Approval Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1640, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "={{ $('📱 Telegram: Photo Received').item.json.message.chat.id }}",
        "text": "❌ Please send a *photo* \\(not a file or text\\)\\. Take a pic of your food and send it\\!",
        "additionalFields": { "parse_mode": "MarkdownV2" }
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "❌ No Photo Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [540, 440],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "📱 Telegram: Photo Received": {
      "main": [
        [{ "node": "📸 Has Photo?", "type": "main", "index": 0 }]
      ]
    },
    "📸 Has Photo?": {
      "main": [
        [{ "node": "📥 Get File Path from Telegram", "type": "main", "index": 0 }],
        [{ "node": "❌ No Photo Error", "type": "main", "index": 0 }]
      ]
    },
    "📥 Get File Path from Telegram": {
      "main": [
        [{ "node": "🔗 Build Photo URL", "type": "main", "index": 0 }]
      ]
    },
    "🔗 Build Photo URL": {
      "main": [
        [{ "node": "💬 Send Processing Notice", "type": "main", "index": 0 }]
      ]
    },
    "💬 Send Processing Notice": {
      "main": [
        [{ "node": "🤖 Run Full AI Pipeline", "type": "main", "index": 0 }]
      ]
    },
    "🤖 Run Full AI Pipeline": {
      "main": [
        [{ "node": "💾 Save Pending Post", "type": "main", "index": 0 }]
      ]
    },
    "💾 Save Pending Post": {
      "main": [
        [{ "node": "📨 Send Approval Message", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "pizza-social-ai" }]
}
